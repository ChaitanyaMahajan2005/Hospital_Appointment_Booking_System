rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'cmahajan328@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isDoctor() {
      return isSignedIn() && (
        request.auth.uid == '33alhlNdEfbVTRlx2kTDPzJElmj1' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'doctor')
      );
    }

    function getDoctorId() {
      return request.auth.uid == '33alhlNdEfbVTRlx2kTDPzJElmj1' ? 'DOC001' :
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) ?
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.doctorId : '');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_-]+$');
    }

    // User profile document
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin() || isDoctor();
      allow list: if isAdmin();
      // Patient/user can create their own profile, cannot elevate role to admin/doctor
      allow create: if (isOwner(userId) || isAdmin()) && isValidId(userId);
      allow update: if (isOwner(userId) && (!('role' in request.resource.data) || request.resource.data.role == resource.data.role))
                    || isAdmin();
      allow delete: if isAdmin();
    }

    // Doctor directory collection
    match /doctors/{doctorId} {
      // Anyone (patients & public) can view active doctor list
      allow get, list: if true;
      // Doctors can update their own non-security profile fields
      allow update: if isAdmin() || (
        isDoctor() && (
          resource.data.uid == request.auth.uid ||
          resource.data.id == getDoctorId()
        )
      );
      allow create, delete: if isAdmin();
    }

    // Hospital Appointments
    match /appointments/{appointmentId} {
      allow get: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        isAdmin() ||
        (isDoctor() && (resource.data.doctorId == getDoctorId() || resource.data.doctorId == request.auth.uid))
      );
      allow list: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        isAdmin() ||
        (isDoctor() && (resource.data.doctorId == getDoctorId() || resource.data.doctorId == request.auth.uid))
      );
      allow create: if isSignedIn() 
        && (request.resource.data.userId == request.auth.uid || isAdmin()) 
        && isValidId(appointmentId);
      // Patients can update/cancel their own appointment
      // Doctors can update appointment status for their assigned appointments
      // Admins have full update rights
      allow update: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        isAdmin() ||
        (isDoctor() && (resource.data.doctorId == getDoctorId() || resource.data.doctorId == request.auth.uid))
      );
      allow delete: if isAdmin();
    }
  }
}
